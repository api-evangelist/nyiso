    },
    "north": {
      "type": "integer",
      "title": "North",
      "description": "CSV column \"North\"; observed example value: 556"
    },
    "west": {
      "type": "integer",
      "title": "West",
      "description": "CSV column \"West\"; observed example value: 1645"
    },
    "nyiso": {
      "type": "integer",
      "title": "NYISO",
      "description": "CSV column \"NYISO\"; observed example value: 16447"
    }
  },
  "required": [
    "time_stamp",
    "capitl",
    "centrl",
    "dunwod",
    "genese",
    "hud_vl",
    "longil",
    "mhk_vl",
    "millwd",
    "n_y_c",
    "north",
